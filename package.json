{
  "name": "schema-pack",
  "version": "0.0.0-commit.26afe064c7a56c37bf7fb74f67222a4decd06fd4",
  "private": true,
  "license": "MIT",
  "author": "Elvis Muñoz <elvis.munoz.f@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "build:docs": "pnpm --filter @schema-pack/website run build:prod",
    "clean": "git clean -dfqX -- packages/**/dist packages/**/tsconfig*tsbuildinfo node_modules packages/**/node_modules",
    "docs": "pnpm --filter @schema-pack/website run dev",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint-staged": "lint-staged",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "vitest",
    "test:ci": "CI=true vitest",
    "tsc": "tsc",
    "tsc:check": "pnpm run tsc && pnpm --filter @schema-pack/website run types:check",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "@pawnary/oxfmt-config": "catalog:",
    "@pawnary/oxlint-config": "catalog:",
    "@pawnary/tsdown-fix-exports": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  }
}
