{
  "name": "@schema-pack/vitest",
  "version": "0.0.0-commit.26afe064c7a56c37bf7fb74f67222a4decd06fd4",
  "description": "Vitest assertion library for serialization",
  "keywords": [
    "assertions",
    "message-pack",
    "schema-pack",
    "serialization",
    "vitest"
  ],
  "license": "MIT",
  "author": "Elvis Muñoz <elvis.munoz.f@gmail.com>",
  "files": [
    "./dist"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/cjs/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./bytesAssertions": {
      "import": "./dist/esm/bytesAssertions.mjs",
      "require": "./dist/cjs/bytesAssertions.cjs"
    },
    "./utils/extractDisplayBytes": {
      "import": "./dist/esm/utils/extractDisplayBytes.mjs",
      "require": "./dist/cjs/utils/extractDisplayBytes.cjs"
    },
    "./utils/isNot": {
      "import": "./dist/esm/utils/isNot.mjs",
      "require": "./dist/cjs/utils/isNot.cjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "vitest": "catalog:"
  }
}
