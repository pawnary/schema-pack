{
  "name": "@schema-pack/vitest",
  "version": "0.0.0",
  "description": "Vitest assertion library for serialization",
  "type": "module",
  "files": [
    "./dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "keywords": [
    "vitest",
    "assertions",
    "serialization",
    "message-pack",
    "schema-pack"
  ],
  "author": "Elvis Muñoz <elvis.munoz.f@gmail.com>",
  "license": "MIT",
  "sideEffects": true,
  "devDependencies": {
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "vitest": "^4.1.10"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/cjs/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./bytes-assertions": {
      "import": "./dist/esm/bytes-assertions.mjs",
      "require": "./dist/cjs/bytes-assertions.cjs"
    },
    "./package.json": "./package.json"
  }
}
