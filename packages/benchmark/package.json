{
  "name": "@schema-pack/benchmark",
  "version": "0.0.0-commit.26afe064c7a56c37bf7fb74f67222a4decd06fd4",
  "description": "Serialization benchmark suite",
  "keywords": [
    "benchmark",
    "message-pack",
    "schema-pack",
    "serialization"
  ],
  "homepage": "https://github.com/pawnary/schema-pack/tree/master/packages/benchmark#readme",
  "bugs": {
    "url": "https://github.com/pawnary/schema-pack/issues"
  },
  "license": "MIT",
  "author": "Elvis Muñoz <elvis.munoz.f@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawnary/schema-pack.git"
  },
  "files": [
    "./dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/cjs/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./dataTypesFactory": {
      "import": "./dist/esm/dataTypesFactory.mjs",
      "require": "./dist/cjs/dataTypesFactory.cjs"
    },
    "./instrumentedBench/adapters/benchAdapter": {
      "import": "./dist/esm/instrumentedBench/adapters/benchAdapter.mjs",
      "require": "./dist/cjs/instrumentedBench/adapters/benchAdapter.cjs"
    },
    "./instrumentedBench/adapters/cliAdapter": {
      "import": "./dist/esm/instrumentedBench/adapters/cliAdapter.mjs",
      "require": "./dist/cjs/instrumentedBench/adapters/cliAdapter.cjs"
    },
    "./instrumentedBench/instrumentedBench": {
      "import": "./dist/esm/instrumentedBench/instrumentedBench.mjs",
      "require": "./dist/cjs/instrumentedBench/instrumentedBench.cjs"
    },
    "./instrumentedBench/types": {
      "import": "./dist/esm/instrumentedBench/types.mjs",
      "require": "./dist/cjs/instrumentedBench/types.cjs"
    },
    "./serializersBenchSuite": {
      "import": "./dist/esm/serializersBenchSuite.mjs",
      "require": "./dist/cjs/serializersBenchSuite.cjs"
    },
    "./serializersDataTypeBench": {
      "import": "./dist/esm/serializersDataTypeBench.mjs",
      "require": "./dist/cjs/serializersDataTypeBench.cjs"
    },
    "./spbench/cli": {
      "import": "./dist/esm/spbench/cli.mjs",
      "require": "./dist/cjs/spbench/cli.cjs"
    },
    "./types": {
      "import": "./dist/esm/types.mjs",
      "require": "./dist/cjs/types.cjs"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "console-table-printer": "catalog:",
    "tinybench": "catalog:"
  },
  "dependencies": {
    "es-toolkit": "catalog:",
    "log-update": "catalog:"
  }
}
