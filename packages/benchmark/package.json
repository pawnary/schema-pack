{
  "name": "@schema-pack/benchmark",
  "version": "0.0.0",
  "description": "Serialization benchmark suite",
  "type": "module",
  "files": [
    "./dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "keywords": [
    "benchmark",
    "serialization",
    "message-pack",
    "schema-pack"
  ],
  "author": "Elvis Muñoz <elvis.munoz.f@gmail.com>",
  "license": "MIT",
  "sideEffects": false,
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@jsonjoy.com/json-pack": "^18.28.0",
    "@msgpack/msgpack": "^3.1.3",
    "@types/selenium-webdriver": "^4.35.6",
    "chalk": "^5.6.2",
    "console-table-printer": "^2.16.1",
    "esbuild": "^0.28.1",
    "msgpackr": "^2.0.3",
    "selenium-webdriver": "^4.44.0",
    "tinybench": "^6.1.2",
    "ts-node": "^10.9.2"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/cjs/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./dataTypesFactory": {
      "import": "./dist/esm/dataTypesFactory.mjs",
      "require": "./dist/cjs/dataTypesFactory.cjs"
    },
    "./serializerBenchSuite": {
      "import": "./dist/esm/serializerBenchSuite.mjs",
      "require": "./dist/cjs/serializerBenchSuite.cjs"
    },
    "./serializerDataTypeBench": {
      "import": "./dist/esm/serializerDataTypeBench.mjs",
      "require": "./dist/cjs/serializerDataTypeBench.cjs"
    },
    "./types": {
      "import": "./dist/esm/types.mjs",
      "require": "./dist/cjs/types.cjs"
    },
    "./package.json": "./package.json"
  }
}
